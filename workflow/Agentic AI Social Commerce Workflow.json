    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.product_id,\n    p.product_name,\n    p.price,\n    p.material,\n    pv.colour,\n    pv.size,\n    pv.stock_qty\nFROM products p\nJOIN product_variants pv\n    ON p.product_id = pv.product_id\nWHERE p.product_id = $1\n  AND pv.size = $2;",
        "options": {
          "queryReplacement": "={{ $json.product_id }}, {{ $json.size }}"
        }
      },
